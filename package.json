{
  "name": "random-activity-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node scripts/generate-system-seed.mjs --check && vitest run && npm run test:db",
    "test:db": "node tests/database.test.mjs && node tests/system-seed.database.test.mjs && node tests/collaborative.database.test.mjs",
    "seed:generate": "node scripts/generate-system-seed.mjs"
  },
  "dependencies": {
    "lucide-react": "0.468.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.4.3",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "jsdom": "27.4.0",
    "typescript": "5.9.3",
    "vite": "8.3.0",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  }
}
